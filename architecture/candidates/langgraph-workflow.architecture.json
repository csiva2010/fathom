 "cards": [
  {
   "dot": "violet",
   "title": "Routing",
   "items": [
    "router asks the LLM for a structured RoutePlan: agents, confidence, tickers, standalone query",
    "Advice request -> advice_redirect; confidence below 0.6 -> clarify; otherwise one Send per agent (max 3)",
    "No LLM: keyword rules pick agents; nothing matched -> Finance Q&A"
   ]
  },
  {
   "dot": "emerald",
   "title": "Parallel agents",
   "items": [
    "Chosen agents run concurrently; outputs merge through the agent_outputs reducer",
    "Each agent: prepare (retrieve / load data), LLM tool loop (max 3 rounds, allow-listed tools), AgentOutput",
    "A timeout or error becomes a NodeError; a missing Tax agent is substituted by Q&A"
   ]
  },
  {
   "dot": "rose",
   "title": "Guardrails",
   "items": [
    "Advice wording is rewritten once by the LLM, else those sentences are removed",
    "KB answers without citations get a note; market answers get the disclaimer"
   ]
  },
  {
   "dot": "cyan",
   "title": "State + streaming",
   "items": [
    "The checkpointer saves FinanceState after each step, keyed by conversation id",
    "stream_turn maps router, agent and compliance updates to SSE events; tokens stream live"
   ]
  }
 ]
}