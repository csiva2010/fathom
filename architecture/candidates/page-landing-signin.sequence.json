    {
      "dot": "rose",
      "title": "Session",
      "items": [
        "The HttpOnly session cookie is invisible to JavaScript; GET /me answers whether you are signed in",
        "CurrentUserDep verifies the cookie on every request and refreshes it near expiry"
      ]
    },
