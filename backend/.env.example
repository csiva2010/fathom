# Copy to .env and fill in. Never commit .env.
# Nested config.yaml values can be overridden with "__", e.g. AUTH__MODE=stub.

# --- Session ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me

# --- Local ports (keep the same values as in frontend/.env) ---
# The web app URL, CORS origin and Google redirect URI are derived from WEB_PORT.
WEB_PORT=5173
API_PORT=8000

# --- Google OAuth (https://console.cloud.google.com/apis/credentials) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Market data ---
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPHA_VANTAGE_API_KEY=

# --- LLM providers (used from day 2) ---
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Optional tracing ---
LANGSMITH_API_KEY=

# --- Sign-in mode ---
#   google: Google sign-in (default; needs GOOGLE_CLIENT_ID/SECRET)
#   guest:  Google sign-in disabled; "Continue as guest" gives each visitor their own account
#   stub:   local dev only, everyone is one fixed user (refused when APP__ENV=production)
AUTH__MODE=google

# --- Local overrides ---
# APP__ENV=development
